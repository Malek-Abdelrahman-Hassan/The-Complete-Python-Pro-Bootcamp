filters:
  and:
    - file.ext == "md"
properties:
  note.day:
    displayName: Day
  file.name:
    displayName: Note
  note.project:
    displayName: Project
  note.status:
    displayName: Status
  note.started:
    displayName: Started
  note.completed:
    displayName: Completed
  note.created:
    displayName: Created
views:
  - type: table
    name: Days
    filters:
      and:
        - file.inFolder("days")
        - file.hasTag("day")
    order:
      - day
      - file.name
      - project
      - status
      - started
      - completed
    sort:
      - property: day
        direction: ASC
  - type: table
    name: In progress
    filters:
      and:
        - file.inFolder("days")
        - file.hasTag("day")
        - status != "done"
    order:
      - day
      - file.name
      - project
      - started
    sort:
      - property: day
        direction: ASC
  - type: table
    name: Concepts
    filters:
      and:
        - file.inFolder("concepts")
        - file.hasTag("concept")
    order:
      - file.name
      - created
    sort:
      - property: file.name
        direction: ASC
